# Copy to .env (same folder as main.py) and fill in. .env is git-ignored.
# Anything already set in the process environment wins over this file.

# --- API ------------------------------------------------------------------

# Required as "Authorization: Bearer <key>" on every call except /health.
# Leave empty to run open -- fine on 127.0.0.1, never beyond it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ZYPHER_API_KEY=

# 127.0.0.1 = this machine only. 0.0.0.0 = your whole network (set a key first).
ZYPHER_HOST=127.0.0.1
ZYPHER_PORT=8000

# --- storage --------------------------------------------------------------

# Where the ~13.5 GB of weights are downloaded to and loaded from.
ZYPHER_MODEL_PATH=C:\AI\Models\zephyr-7b-beta-abliterated

# Memory store. Default: .memory next to main.py.
# ZYPHER_MEMORY_DIR=

# Sentence encoder for recall.
# ZYPHER_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
