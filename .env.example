# Copy to .env (same folder as main.py) and fill in. .env is git-ignored.
# Anything already set in the process environment wins over this file.

# --- API ------------------------------------------------------------------

# Required as "Authorization: Bearer <key>" on every call except /health.
# Leave empty to run open -- fine on 127.0.0.1, never beyond it.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ZYPHER_API_KEY=

# 127.0.0.1 = this machine only. 0.0.0.0 = your whole network (set a key first).
ZYPHER_HOST=127.0.0.1
ZYPHER_PORT=8000

# Browser apps on other origins allowed to call the API directly, comma
# separated, e.g. http://localhost:3000. Not needed for web/, which forwards
# through its own server.
# ZYPHER_CORS_ORIGINS=

# --- storage --------------------------------------------------------------

# Folder the model weights are downloaded to and loaded from (~4.4 GB), or the
# path of one .gguf file you already have. llama.cpp and the recall encoder
# are installed beside it by default, so pick a drive with ~6 GB free.
ZYPHER_MODEL_PATH=C:\AI\Models\zephyr-7b-beta-abliterated

# Memory store. Default: .memory next to main.py.
# ZYPHER_MEMORY_DIR=

# Sentence encoder for recall, and what runs it: auto (onnxruntime, else
# sentence-transformers, else hashed n-grams), onnx, or torch.
# ZYPHER_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# ZYPHER_EMBED_RUNTIME=auto

# Where the encoder's ONNX export goes (~90 MB). Default: encoders beside the
# model folder.
# ZYPHER_EMBED_DIR=


# --- engine ---------------------------------------------------------------
# All optional: left commented, each is worked out from the hardware.

# llamacpp (default: GGUF on llama.cpp) or transformers (torch + bitsandbytes,
# needs requirements-transformers.txt and the 13.5 GB safetensors weights).
# ZYPHER_BACKEND=llamacpp

# Which GGUF to run. It is downloaded into ZYPHER_MODEL_PATH on first start.
# Any GGUF repository on Hugging Face works; the chat template comes with it.
# ZYPHER_GGUF_REPO=mradermacher/zephyr-7b-beta-abliterated-i1-GGUF
# ZYPHER_GGUF_FILE=zephyr-7b-beta-abliterated.i1-Q4_K_M.gguf
#
# A second model for coding. Set ZYPHER_CODE_MODEL_PATH and coding questions
# in the web chat -- and everything the zy CLI asks -- go to it; the rest stay
# on the model above. Only one is on the GPU at a time: a question for the
# other swaps them (a few seconds once both files are in the OS file cache).
# The web chat also has a Model picker to choose one by hand.
# ZYPHER_CODE_MODEL_PATH=D:\AI\Models\qwen2.5-coder-7b-instruct
# ZYPHER_CODE_GGUF_REPO=bartowski/Qwen2.5-Coder-7B-Instruct-GGUF
# ZYPHER_CODE_GGUF_FILE=Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf
# ZYPHER_CODE_MODEL_ID=qwen2.5-coder-7b

# Where llama.cpp is installed. Default: llama.cpp beside the models folder.
# Or name a llama-server executable you already have and skip the download.
# ZYPHER_LLAMA_DIR=
# ZYPHER_LLAMA_SERVER=

# Context window in tokens. Unset = the largest that keeps every layer on the
# GPU. Prompt and answer budgets are each half of it.
# ZYPHER_CTX=8192

# GPU layers (number, all, auto) and KV cache precision (f16, q8_0, q4_0).
# ZYPHER_GPU_LAYERS=all
# ZYPHER_KV_TYPE=q8_0

# How the weights are read: mmap, none (plain reads), dio, auto. Unset = plain
# reads when the whole model is on the GPU, which keeps it out of system RAM.
# ZYPHER_LOAD_MODE=none

# VRAM (GiB) left for the desktop and other programs.
# ZYPHER_VRAM_RESERVE_GB=0.5

# Unload the model after this many idle seconds (0 = never). Frees the VRAM
# while you are not chatting; the next question waits a few seconds to reload.
# ZYPHER_IDLE_UNLOAD_SECONDS=900

# System RAM (MiB) for swapped-out prompt caches.
# ZYPHER_CACHE_RAM_MB=1024

# Extra llama-server arguments, appended last so they win.
# ZYPHER_LLAMA_ARGS=
