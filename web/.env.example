# Copy to .env and fill in. .env is git-ignored.

# Where `python main.py serve` listens.
ZYPHER_API_URL=http://127.0.0.1:8000

# The same value as ZYPHER_API_KEY in the zypherLL .env. Added to every
# request by the dev/preview server, so the browser never sees it. Leave
# empty if the API runs without a key.
ZYPHER_API_KEY=
